# ==========================================
# APOGEE MISSION CONTROL — Configuration
# ByKpubaq | Adil
# ==========================================

# --- General System Settings ---
APP_NAME="Apogee"
AUTHOR="ByKpubaq | Adil"
DEBUG_MODE=false
DEFAULT_APP_TARGET=ide # 'ide' (9334) | 'agent' (9333) | 'ag2' (9334/custom)
AUTOACCEPT_DEFAULT=true
DEFAULT_MODEL="Gemini 3.7 Flash (High)"

# --- AntiGravity CDP Ports (2.0 / IDE / CLI) ---
AGENT_CDP_PORT=9333     # AntiGravity CLI / Standalone App
IDE_CDP_PORT=9334       # AntiGravity IDE / AntiGravity 2.0
CDP_HOST=127.0.0.1

# --- Telegram Driver ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ALLOWED_USERS=your_telegram_user_id_or_chat_id # comma separated (empty = allow self/all)

# --- Discord Driver ---
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_ALLOWED_CHANNELS=your_discord_channel_id

# --- WhatsApp Web (Unofficial QR Terminal Driver) ---
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_PATH="./sessions/whatsapp"
WHATSAPP_SELF_CHAT_MODE=true # Allow chatting with yourself via 'Saved Messages' / Note to Self
WHATSAPP_ALLOWED_NUMBERS=1234567890@s.whatsapp.net # Comma-separated or empty if self-chat enabled

# --- HTTP REST / Webhook Bridge ---
API_PORT=3890
API_SECRET_KEY=apogee-secret-key-change-me
